-- allium: 3
-- agent-offload.allium

-- Scope: The whole agent-offload system — durable remote coding tasks, the attached
--         relay, and the historical report lane.
-- Includes:
--   Task identity, idempotency, submission, resume, cancellation
--   Continuation of a failed task from its retained partial edits
--   Renewable task time budgets: fixed timeout vs the approved policy
--   Execution-owned status observations with Offload task-admission policy
--   Task worker execution constraints, requested checks, result publication
--   Result retrieval validation, change application, application journal
--   Attached relay sessions, confined local tools, provenance, fail-closed evidence
--   Historical job retrieval validation and retirement refusals
-- Excludes:
--   Weft internals (scheduling, source snapshots, job lifecycle, artifact storage):
--     external boundary, specified elsewhere
--   agent-execution writer internals: the writer's coding behavior is a black box
--     behind its evidence contract
--   OMP harness behavior and SSH transport: external boundaries
--   Retired native Codex worker internals: only its refusal surface and the
--     validation of its historical artifacts are specified
-- Terminology:
--   Task worker: agent-offload-task-worker, the durable lane's remote writer
--   Nested worker: the retired historical lane's inner worker, evidence-only
--   Task result / historical worker result / relay result record: the three
--     distinct result artifacts, never interchangeable
-- Invariants confirmed as deliberate design: evidence-based status,
--   least-capability lanes, fail-closed with no fallback. Atomic serialized
--   application and explicit consequential steps are enforced per rule, not
--   asserted as system invariants.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity Principal {
    -- Placeholder for any party at a boundary: the local consumer (a coding
    -- agent or a human driving the CLI), or the relay's remote agent runtime.
}

external entity Project {
    root: String
}

external entity WeftJob {
    id: String
    status: queued | running | completed | failed | dead | canceled | cancelled | killed
    source_pin: String?
    exit_code: Integer?
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value BaselineEntry {
    path: String
    content_digest: String
    mode: Integer
}

value BaselineManifest {
    -- Exactly the files the Weft source snapshot carries. Files under the
    -- excluded cache directories (dependency, build and tool caches) never
    -- enter the baseline, and changes under them are invisible by design:
    -- not validated, not captured, not applied.
    entries: List<BaselineEntry>
}

value Change {
    path: String
    deleted: Boolean
    before_content_digest: String?
    before_mode: Integer?
    after_content: String?
    after_mode: Integer?

    -- Content fields are text (String). A binary baseline file therefore
    -- cannot be edited, deleted, or mode-changed through this lane at all:
    -- the refusal is intended, and such changes happen outside the system.
}

value CheckOutcome {
    command: List<String>
    exit_code: Integer?
    timed_out: Boolean
    stdout_tail: String
    stderr_tail: String
}

value RenewableBudget {
    -- The renewable time policy persisted in an immutable request. The
    -- extension and the progress window are fixed by the approved policy;
    -- only the initial amount and the finite cap are caller-chosen, and a
    -- fixed `--timeout` request carries no policy at all.
    initial_seconds: Duration
    extension_seconds: Duration
    progress_window_seconds: Duration
    max_seconds: Duration
}

value RenewableBudgetEvidence {
    -- Execution-owned, validated, versioned telemetry for one attempt under
    -- a renewable policy. It describes observed activity, never usefulness
    -- or billed cost, and lives only inside the task result's worker record.
    policy: RenewableBudget
    duration: Duration
    decisions: List<String>        -- each extension granted or refused, with evidence age
    termination_reason: String
    progress_count: Integer
    changed_file_count: Integer    -- distinct files actually changed
}

value ApplicationBackup {
    changes: List<Change>
}

value ContextFile {
    name: String
    content_digest: String
}

value ServedPath {
    path: String
    content_digest: String
    byte_count: Integer
    truncated: Boolean
}

value ToolCall {
    tool: String
    is_error: Boolean
    served_paths: List<ServedPath>
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract EvidenceContract {
    @invariant Identity
        -- An accepted artifact carries the digests of the exact request,
        -- worker source, and report it was produced from. A mismatch with
        -- the retained dispatch refuses the artifact.
    @invariant Completeness
        -- Partial, ambiguous, or unreadable evidence is refused or reported
        -- as unresolved; it is never promoted to success and never silently
        -- retried or substituted from a current installation.
    @invariant Provenance
        -- Every byte the system serves or applies is recorded with a content
        -- digest of exactly those bytes.
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Task {
    id: String
    project: Project
    brief: String
    selector: String
    check: List<String>?
    timeout: Duration
        -- A fixed request's hard writer limit, or a budgeted request's
        -- renewable initial amount; it still bounds ordinary validation.
    budget: RenewableBudget?
        -- Null means timeout is the writer's fixed hard limit and renewal
        -- never happens; present, timeout is the renewable initial amount.
        -- The complete policy is validated before persistence and again at
        -- worker entry: exact shape, numeric bounds, the fixed extension and
        -- window, a finite cap within 240 minutes that accommodates the
        -- extension, and consistency with timeout. Requests stored without
        -- one keep their fixed meaning across upgrades.
    account: String
    baseline: BaselineManifest
    symlinks: Map<String, String>?
        -- The literal relative symlinks the snapshot carries, relative path
        -- to literal relative target. Each entry must be a safe relative path
        -- that neither collides with a baseline or carried file nor nests
        -- under another link, and must resolve, through any chain, to an
        -- existing in-root path without crossing protected or excluded
        -- content; the literal target is immutable evidence. New requests
        -- always include the field, even as {}; explicit {} means a strictly
        -- observed empty inventory. The optional value here denotes a missing
        -- wire field on a legacy request; an explicit JSON null is invalid.
        -- Weft formerly materialized absolute links and relative links whose
        -- literal target lexically escaped the snapshot. Relative links whose
        -- literal target stayed within it were carried and refused as
        -- unrecorded at legacy dispatch. Legacy resume/apply do not compare a
        -- local link inventory; continuations inherit its absence.
    request_digest: String
    parent_task: Task?
    seed_changes: List<Change>?
        -- A continuation retains a validated partial proposal from its parent.
        -- It also binds the parent job, request, and canonical result digest.
    worker_source_digest: String
    worker_build_id: String?
    worker_bin_dir: String?
        -- The immutable worker build provisioned for this dispatch on the
        -- task's host and account. The job launches that build's task
        -- worker by absolute path, never by PATH name, so a queued job runs
        -- the build it was sent with and the host's build cleanup can see
        -- the build is still needed. A record from before provisioning
        -- existed has neither and is provisioned when resumed.
    attempt: Integer
    job: WeftJob?
    prior_job_ids: List<String>
    submission_started: Boolean
        -- False until the current attempt first enters Weft; persisted before entry.
    provisioning: String
        -- pending before the current attempt's first provisioning call,
        -- in_progress while the pinned build is provisioned, ready after,
        -- failed with the reason retained. A record written before the field
        -- existed reports unknown, except that a retained build identity
        -- still derives ready.
    cancelled_without_job: String?
        -- For a jobless closure: never_submitted when the durable start
        -- marker proves no send was attempted, weft_reported_no_job when a
        -- final fence answer proved the key jobless.
    error: String?

    -- Evidence-based status. completed, failed and validation_failed come
    -- only from a validated task result. queued and running mirror the
    -- accepted Weft job's observed lifecycle. unknown means observation or
    -- evidence was unreadable; it never implies success.
    status: submitting | submission_unknown | queued | running | completed | failed | validation_failed | failed_without_result | unknown | applied | cancelled

    applied_at: Timestamp when status = applied
    processed_at: Timestamp?
        -- Current-job acknowledgment or local predispatch closure; cleared for a new attempt.
    backup: ApplicationBackup?

    result: TaskResult with task = this

    invariant AppliedTerminal {
        status = applied implies applied_at != null
    }
}

entity TaskResult {
    task: Task
    status: completed | failed | validation_failed
    worker_completed: Boolean
    worker_source_digest: String
    request_digest: String
    report: String
    changes: List<Change>
    validation: CheckOutcome?
    budget_evidence: RenewableBudgetEvidence?
        -- Present only when the task ran under a renewable policy; parsed
        -- and validated with the worker result at retrieval, never a
        -- separate artifact. Describes observed activity, never usefulness
        -- or billed cost.

    invariant ValidationFailureCarriesOutcome {
        status = validation_failed implies validation != null
    }

    invariant ValidationOnlyWhenRequested {
        task.check = null implies validation = null
    }

    invariant ChangesWithinBounds {
        changes.count <= config.max_change_files
    }
}

entity RelaySession {
    project: Project
    prompt_digest: String
    context_files: List<ContextFile>
    selector: String
    timeout: Duration
    started_at: Timestamp
    registered_tools: Set<String>
    remote_events: List<String>
    read_calls: List<ToolCall>
    final_response: String?
    failure: String?

    -- Attached and live: the record states what this session is, and the
    -- validator refuses any other durability claim.
    status: running | completed | failed | cancelled
    durability: String
    snapshot_equivalent: Boolean

    invariant BlankRoomRecorded {
        durability = "none-attached-live-local-tools"
        snapshot_equivalent = false
    }
}

entity HistoricalJob {
    job: WeftJob
    expected_task_id: String

    -- refused is terminal and permanent: the artifacts stay available in
    -- Weft, and the job is never marked processed.
    status: unvalidated | validated | refused | processed
    processed_at: Timestamp?
    refusal_reason: String?

    result: HistoricalResult with record = this

    invariant RefusalsNeverProcessed {
        status = refused implies processed_at = null
    }
}

entity HistoricalResult {
    record: HistoricalJob
    envelope_status: completed | preflight_failed | harness_failed | evidence_failed
    provider: String
    mode: String
    selector: String
    prompt_digest: String
    report: String
    report_digest: String
    snapshot_preserved: Boolean
    nested_evidence_present: Boolean
    nested_source_digest_retained: Boolean
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    admitted_selector: String = "openai-codex/gpt-6-luna"    -- durable lane writer
    historical_selector: String = "gpt-5.5"                  -- retired lane, validation only
    pinned_relay_selector: String = "anthropic/claude-opus-5-5"
    default_worker_account: String = "agent"

    max_task_timeout: Duration = 120.minutes
    check_timeout: Duration = 15.minutes

    budget_initial_seconds: Duration = 60.minutes             -- approved renewable start
    budget_extension_seconds: Duration = 30.minutes           -- fixed per-extension grant
    budget_progress_window_seconds: Duration = 15.minutes     -- progress evidence window
    budget_cap_seconds: Duration = 240.minutes                -- finite absolute cap

    max_file_bytes: Integer = 2 * 1024 * 1024                -- per returned file
    max_change_files: Integer = 10000
    max_bundle_bytes: Integer = 64 * 1024 * 1024

    relay_default_timeout: Duration = 10.minutes
    relay_grace: Duration = 30.seconds
    relay_context_file_bytes: Integer = 32 * 1024
    relay_max_tool_args_bytes: Integer = 64 * 1024
    relay_max_read_bytes: Integer = 512 * 1024
    relay_max_result_bytes: Integer = 256 * 1024
    relay_max_match_files: Integer = 500
    relay_max_grep_matches: Integer = 500
    relay_max_traversed_files: Integer = 2000
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Durable task lane: submission and resume

rule SubmitTask {
    when: SubmitTask(caller, project, brief, selector, check, timeout, budget?, account?, requested_id?)

    requires: length(brief) > 0
    requires: writer_selector_admitted(selector)
    requires: timeout >= 1.second and timeout <= config.max_task_timeout
    requires: budget = null or valid_renewable_budget(budget, timeout)
        -- Exactly one time choice: a fixed timeout is the writer's hard
        -- limit and never renews; a renewable budget keeps the extension and
        -- window at the approved fixed values, bounds the initial by
        -- 1-7200s, bounds the finite cap by the 14400s ceiling with room for
        -- the extension, and makes timeout the initial amount. A malformed
        -- or conflicting policy -- a non-object, a boolean, NaN, infinity, a
        -- missing or unexpected field, a bound violation, a cap without
        -- room, or an initial that disagrees with timeout -- refuses before
        -- anything is persisted, censused, provisioned, or sent.
    requires: check = null or path_dependencies_within_snapshot(project)
        -- A check cannot run against dependencies outside the snapshot; a
        -- project without a check is accepted regardless.
    requires: requested_id = null or not Tasks.any(t => t.id = requested_id)
    requires: carries_confined_links_only(project)
        -- Confined relative symlinks are carried as read-only link objects in
        -- the request's symlinks inventory, never recursed through during
        -- census. A link under an excluded path is dropped with it, exactly
        -- like an ordinary file. Every kept link must resolve, through any
        -- chain, to an existing path inside the project: an absolute target,
        -- an escape (including an indirect one, while confined relative `..`
        -- steps are fine), a cycle, a dangling link, and a target crossing
        -- protected or excluded content each refuse the submission with the
        -- link named, instead of being silently dropped or materialized.
        -- Escaping links are refused rather than materialized from external
        -- content.

    ensures:
        let task = Task.created(
            id: requested_id ?? generated_task_id(),
            project: project,
            brief: brief,
            selector: selector,
            check: check,
            timeout: timeout,
            budget: budget,
                -- Null for an explicit fixed --timeout; the approved policy
                -- when the caller passes no time flag at all.
            account: account ?? config.default_worker_account,
            baseline: baseline_manifest(project),
            symlinks: confined_link_inventory(project),
                -- Always explicit for fresh submissions, including {}. A
                -- continuation inherits its parent's field only if present.
            request_digest: digest_of(brief),
            worker_source_digest: bundled_worker_digest(),
            worker_build_id: null,
            worker_bin_dir: null,
            attempt: 1,
            job: null,
            prior_job_ids: [],
            submission_started: false,
            provisioning: "pending",
            status: submitting
        )
    ensures: WorkerProvisioningRequested(task)
    @guidance
        -- The retained request and the submitting record are durable before
        -- the worker is provisioned and the job is sent, so an interrupted
        -- or refused submission leaves a resumable identity. There is no
        -- local-execution fallback: a send that cannot be resolved leaves the
        -- task submission_unknown for explicit resume.
        -- The send records the job and leaves host dispatch to Weft's daemon,
        -- so its budget covers source pinning and recording only. A send
        -- that outlives the budget is resolved by looking the idempotency key
        -- up: a recorded job is accepted, and a key Weft never recorded is
        -- sent once more. A failed or malformed lookup is not evidence of
        -- absence and makes the send unresolved, as does a second failure.
        -- The send's outer wall time covers one whole attempt: the fixed
        -- timeout's documented seconds plus 1020, or, for a budgeted task,
        -- the ceiling of the finite cap plus 1020 -- never the initial
        -- amount alone, so renewal can actually use the cap it is granted.
    @guidance
        -- The task executes the agent-execution bundled inside its pinned
        -- offload build, not the separately installed worker on PATH.
        -- Provisioning validates both package digests before queueing.
        -- A caller-chosen id that already exists is refused in favor of resume.
        -- An empty file census is a valid baseline; census errors still refuse.
}

rule ProvisionWorker {
    when: WorkerProvisioningRequested(task)

    requires: provisioned_build_matches(task)
        -- Provisioning builds an immutable, content-addressed worker for
        -- the task's host and account without activating it: the host's
        -- current build and PATH are untouched. There is exactly one
        -- mechanism: the installed agent-offload and agent-execution
        -- packages are copied over SSH, so the build is deterministic from
        -- the installed pinned pair and independent of any source checkout.
        -- The configured provider value is accepted for compatibility but no
        -- longer selects a builder. The build is accepted only when the
        -- identity its own worker reports carries an agent-offload source
        -- digest equal to the request's offload digest and an
        -- agent-execution source digest equal to the request's execution
        -- digest.
    ensures: task.worker_build_id = provisioned_build(task).id
    ensures: task.worker_bin_dir = provisioned_build(task).bin_dir
    ensures: task.provisioning = "ready"
    ensures: SubmissionSent(task)
}

rule RefuseMismatchedWorker {
    when: WorkerProvisioningRequested(task)

    requires: not provisioned_build_matches(task)
    ensures: ProvisioningRefusalReported(task)
    @guidance
        -- The refusal happens before any Weft job exists, and the task keeps
        -- its identity with no job and no recorded build. The diagnostic
        -- names which side differs and both digests. The refused case is a
        -- pinned build the install can no longer supply: the pinned bytes
        -- are never reconstructed from a checkout, no reinstall or checkout
        -- rewrite is attempted automatically, and that identity cannot
        -- resume -- the caller submits a new task for the same brief. Any
        -- other provisioning failure keeps the identity and names the
        -- same-ID resume that retries provisioning. A failed or malformed
        -- provisioning answer refuses the same way.
}

rule SubmissionAccepted {
    when: SubmissionSent(task)

    requires: send_succeeded(task)
    ensures: task.job = accepted_job(task)
    ensures: task.status = queued
    ensures: task.error = null
}

rule SubmissionUnresolved {
    when: SubmissionSent(task)

    requires: not send_succeeded(task)
    ensures: task.status = submission_unknown
    ensures: task.error = send_error(task)
}

rule ResumeTask {
    when: ResumeTask(caller, task)

    -- Any terminal job state whose task never published a valid result is
    -- resumable as a new attempt, except a job the consumer explicitly
    -- canceled.
    requires: task.result = null
    requires: task.status not in {applied, cancelled}
    requires: task.job = null or task.job?.status in {failed, dead, killed}
    requires: task.job = null or not task.job?.status in {canceled, cancelled}
    requires: baseline_unchanged(task) or accepted_receipt_recoverable(task)
        -- For every unresolved task, lookup precedes the baseline check.
        -- A valid accepted receipt binds its existing job despite local drift;
        -- absence or lookup failure never permits sending changed source.
        -- For an inventory-bearing request, baseline_unchanged also covers
        -- link drift. Legacy absence preserves baseline/carried checks without
        -- inventing an empty link census; resubmission still refuses
        -- unrecorded carried links.
    requires: task.job = null or submitter_unchanged(task)
    requires: task.job = null or provisioned_build_matches(task)
    requires: task.job = null or weft_accepts_processed(task.job)
        -- A resubmission provisions again before anything changes, so a
        -- refusal leaves the failed attempt exactly as it was.

    ensures:
        if task.job = null:
            if accepted_receipt_recoverable(task):
                task.job = accepted_job(task)
                task.status = queued
                task.error = null
            else if task.worker_build_id = null:
                WorkerProvisioningRequested(task)
            else:
                SubmissionSent(task)
        else:
            task.worker_build_id = provisioned_build(task).id
            task.worker_bin_dir = provisioned_build(task).bin_dir
            task.prior_job_ids = task.prior_job_ids + task.job?.id
            task.attempt = task.attempt + 1
            task.job = null
            task.processed_at = null
            task.status = submitting
            task.submission_started = false
            SubmissionSent(task)
    @guidance
        -- An unsubmitted or unresolved submission resumes under the same
        -- idempotency identity, so Weft cannot accept a second job for it. A
        -- terminal job without a result resumes under a fresh attempt-scoped
        -- identity, keeping the task's identity while listing the earlier
        -- job in prior_job_ids. A terminal job without a result is resubmitted
        -- only if the submitting machine's agent-offload and agent-execution
        -- digests still equal the retained request's; otherwise the caller
        -- submits a new task. An unresolved submission resumes regardless of
        -- submitting code changes, to recover the accepted job under the
        -- same identity.
        -- The dead attempt is acknowledged before its identity is archived.
        -- A failed acknowledgment retains the old identity and queues nothing.
    @guidance
        -- An unresolved submission keeps its recorded build: Weft may
        -- already hold a job under its idempotency key, so the resend must
        -- repeat the same command. Only a record that never had a build is
        -- provisioned. A resubmission provisions afresh, which repairs a
        -- build that changed or was collected while the failed job queued.
}

rule ContinueTask {
    when: ContinueTask(caller, parent, timeout, budget?, supplement?, requested_id?, selector_override?)

    requires: parent.result != null and parent.result.status in {failed, validation_failed}
        -- A validated published result is the only continuation seed. A
        -- succeeded parent is applied instead; a cancelled, running, or
        -- result-less parent, and a result that fails validation against the
        -- parent's retained dispatch, are refused.
    requires: parent.result.worker != null
        -- Setup or census failures without a validated edit snapshot cannot
        -- seed a continuation; their empty changes do not erase inherited edits.
        -- Continue an earlier ancestor with retained edits, or submit a fresh task.
    requires: parent.status != applied
        -- Continuing an applied task could duplicate edits already in the
        -- project.
    requires: baseline_unchanged(parent, including additions)
        -- The whole editable manifest and carried census must equal the
        -- parent's baseline, including path sets: a new local file that could
        -- collide with a seeded addition refuses. An observed link inventory
        -- must also match; legacy absence permits links Weft materialized
        -- (absolute or lexically escaping targets) but refuses unrecorded
        -- links Weft would carry, based on literal targets. Nothing is written
        -- locally, and the child inherits inventory presence or absence.
    requires: timeout >= 1.second and timeout <= config.max_task_timeout
    requires: budget = null or valid_renewable_budget(budget, timeout)
        -- The child's time choice is fresh and explicit: a fixed --timeout
        -- or an explicit renewable initial with its optional finite cap,
        -- validated like any submitted policy. It never inherits the
        -- parent's budget or its exhaustion, and the parent's retained
        -- request is unchanged.
    requires: selected = selector_override ?? parent.selector
    requires: selected in OMP_WRITER_SELECTORS
        -- Validate the selected exact writer, not a retired inherited parent
        -- when the caller supplies a replacement.
    requires: requested_id = null or not Tasks.any(t => t.id = requested_id)
    ensures:
        let child = Task.created(
            id: requested_id ?? generated_task_id(),
            project: parent.project,
            brief: continuation_brief(
                parent.brief,
                supplement,
                untrusted_validation_diagnostic(parent.result, parent.check)
            ),
                -- Preserves requirements/manual instructions and adds validated
                -- failed-check output as bounded quoted untrusted data.
            selector: selected,
            check: parent.check,
            timeout: timeout,
            budget: budget,
            account: parent.account,
            baseline: parent.baseline,
            symlinks: parent.symlinks,
                -- Inherit presence as well as value: an inventory-bearing
                -- parent's links are checked strictly; a historical parent
                -- with no inventory gives its child no inventory field, not
                -- a fabricated observed {}.
            parent_task: parent,
            seed_changes: parent.result.changes,
            worker_source_digest: bundled_worker_digest(),
                -- The child is pinned to the build dispatching it, which may
                -- be newer than the build that produced the parent.
            attempt: 1,
            job: null,
            prior_job_ids: [],
            submission_started: false,
            provisioning: "pending",
            status: submitting
        )
    ensures: parent = parent_before
        -- The parent is evidence: continue reads it and never acknowledges,
        -- cancels, or mutates it, whether or not cancel already closed it.
    ensures: WorkerProvisioningRequested(child)
    @guidance
        -- The child request retains the parent task, job, and request
        -- identities and a canonical digest of the parent's published result
        -- artifact (never a duplicated transcript), plus the validated seed.
        -- The child request is durable before any remote side effect, so an
        -- interrupted or ambiguous send recovers with `task resume CHILD`
        -- under one idempotency key and cannot cause duplicate jobs.
}

rule CancelBeforeDispatch {
    when: CancelTask(caller, task)
    requires: task.job = null
    requires: task.submission_started = false
    requires: task.status != submission_unknown
    ensures: task.status = cancelled
    ensures: task.cancelled_without_job = "never_submitted"
    ensures:
        if task.processed_at = null:
            task.processed_at = now
    @guidance
        -- A proven never-submitted attempt closes locally and retains its request.
        -- Repeated cancellation is idempotent; resume cannot resurrect this identity.
}

rule FenceAmbiguousSubmission {
    when: CancelTask(caller, task)
    requires: task.job = null
    requires: task.submission_started != false or task.status = submission_unknown
    ensures:
        PublicWeftCommand("weft job fence --idempotency-key K --json", task.project)
    ensures:
        if ValidFence(api_version = "weft.job.fence.v1", key = K, fenced = true, receipt = null):
            task.status = cancelled
            task.cancelled_without_job = "weft_reported_no_job"
            task.processed_at = now
        else if ValidFence(api_version = "weft.job.fence.v1", key = K, fenced = false, receipt = R):
            Persist(task.job = R.job_id, task.host = R.selected_host, task.source_pin = R.source_pin)
            CancelTask(caller, task)
    @guidance
        -- A fenced true answer carries no receipt field at all; receipt = null
        -- above means the field is absent. An explicit null receipt, or any
        -- populated one, contradicts fenced true and preserves custody.
        -- Fence errors and contradictions preserve custody; lookup absence is not finality.
        -- Bind a returned receipt before cancellation/acknowledgment; preserve request history.
        -- The public fence producer must be deployed in the submitting Weft context.
}

rule CancelTask {
    when: CancelTask(caller, task)

    requires: task.job != null
    ensures:
        if not task.job?.status in {completed, failed, dead, canceled, cancelled, killed}:
            CancellationDelegated(task.job)
    ensures: TaskJobAcknowledgmentRequested(task)
    @guidance
        -- Cancellation operates on the accepted Weft job and preserves the
        -- baseline and any applied marker. An ambiguous task with no accepted
        -- job identity must resolve its submission first.
        -- An already-terminal job is disposed without another cancellation.
        -- If cancellation is pending, acknowledgment refuses; repeating
        -- cancel checks the terminal state again before marking processed.
}

-- Durable task lane: observation and evidence

rule MirrorRunningJob {
    when: ObserveTask(caller, task)

    requires: task.result = null
    requires: task.job?.status in {queued, running}
    ensures: task.status = task.job?.status
}

rule ResolveCompletedJob {
    when: ObserveTask(caller, task)

    requires: task.job?.status = completed
    requires: task.result = null
    ensures:
        if artifact_validatable(task):
            TaskEvidenceValidated(task)
        else:
            task.status = unknown
            DiagnosticEmitted(task, "task result unavailable or invalid")
}

rule MarkFailedJob {
    when: ObserveTask(caller, task)

    requires: task.job?.status in {failed, dead, killed}
    requires: task.result = null
    ensures:
        if artifact_validatable(task):
            TaskEvidenceValidated(task)
        else:
            task.status = failed_without_result
            DiagnosticEmitted(task, log_tail(task.job))
    @guidance
        -- The diagnostic carries the job's exit code and the tail of the job
        -- log. Submission provisions the matching worker, so a version
        -- mismatch here means the pinned build changed or disappeared under
        -- the queued job; the hint is to resume, which provisions again,
        -- or to submit a new task if the submitting machine changed.
        -- Weft's `canceled` and `cancelled` statuses pass through `task
        -- status` unmapped.
        -- Implementation delta: a failed job whose publication reports ready
        -- but whose result cannot be read resolves to `unknown` rather than
        -- `failed_without_result`.
}

rule ValidateRetrievedResult {
    when: RetrieveTaskResult(caller, task)

    requires: task.job != null
    requires: artifact_readable(task) and artifact_within_bounds(task)
    requires: artifact_identity_matches(task)
        -- result id, request digest and worker source digest must equal the
        -- retained dispatch.
    requires: worker_evidence_valid(task)
        -- worker identity, admitted tool policy, transcript evidence and
        -- prompt digest must match the retained request.
    requires: change_baselines_match(task)
        -- every change: safe relative path, no duplicates or overlaps,
        -- before-digest and mode equal to the retained baseline for existing
        -- files, absence matching for new files, per-file and bundle bounds.
    ensures: TaskEvidenceValidated(task)
    ensures: task.review = destructive_review_summary(task.result.changes)
        -- Deterministic evidence comes only from validated before/after bytes:
        -- removed paths, removed Python AST test-shaped definitions, and
        -- candidate files that could not be assessed. It is advisory.
    @guidance
        -- Python inventory covers module-level and direct class test_* defs,
        -- not nested helpers or pytest/unittest collection and parameterized
        -- case totals. Unsupported test languages and parse failures are
        -- unassessed. Review metadata does not alter artifact digest binding.
        -- Retrieval never marks the Weft job processed in this lane and
        -- never mutates task state by itself.
}

rule MaterializeTaskResult {
    when: TaskEvidenceValidated(task)

    requires: task.result = null
    ensures:
        let evidence = ArtifactOf(task)
        let result = TaskResult.created(
            task: task,
            status: evidence.status,
            worker_completed: evidence.worker_completed,
            worker_source_digest: evidence.worker_source_digest,
            request_digest: evidence.request_digest,
            report: evidence.report,
            changes: evidence.changes,
            validation: evidence.validation
        )
        task.status = result.status
}

-- Durable task lane: remote worker execution

rule WorkerAcceptsTask {
    when: WorkerExecutionBegan(task, payload)

    requires: payload.request_digest = task.request_digest
    requires: payload.task_id = task.id
    requires: payload.worker_source_digest = task.worker_source_digest
    requires: snapshot_census(task.project) = task.baseline.entries
    requires: snapshot_link_inventory(task.project) = task.symlinks
        -- The exact carried link inventory, verified before generation: a
        -- missing, retargeted, replaced, added, or unsafe link refuses even
        -- when its resolved contents happen to match. The inventory is
        -- censused again after the writer completes and after validation;
        -- the writer may not create, replace, retarget, or delete a link,
        -- and a check that does fails the task as a modified proposal.
    ensures: WorkerSessionStarted(task)
}

rule WorkerPublishesSetupFailure {
    when: WorkerExecutionBegan(task, payload)

    requires: payload.request_digest != task.request_digest
        or payload.task_id != task.id
        or payload.worker_source_digest != task.worker_source_digest
        or snapshot_census(task.project) != task.baseline.entries
        or snapshot_link_inventory(task.project) != task.symlinks
    ensures: ResultArtifactPublished(task)
    ensures: WorkerRefusesFurtherWork(task)
    @guidance
        -- A setup or census failure publishes a failed result with a
        -- diagnostic report and no changes, so the failure stays retrievable;
        -- it never falls back to executing anyway.
}

rule WorkerProposesChanges {
    when: WorkerSessionStarted(task)

    let proposed = writer_edit(task.brief, task.baseline.entries)

    requires: baseline_consistent(task, proposed)
        -- each changed file's before-digest and mode must equal the retained
        -- baseline; a change to a file the snapshot does not carry is
        -- refused; additions and deletions by the writer are legal changes.
    requires: within_change_bounds(proposed)
    ensures: WorkerProposalReady(task, proposed)
    @guidance
        -- The writer edits the snapshot under a workspace-write policy that
        -- admits no shell; its coding behavior is a black box specified only
        -- by this evidence contract.
        -- For a continuation, validate seed_changes against the original
        -- baseline and preflight every destination before materializing them
        -- in the disposable snapshot. The fresh writer starts from that state.
        -- Compute the proposal against the original baseline, including seed
        -- edits retained, reverted, or changed by the writer. A harness failure
        -- retains this cumulative proposal as a failed, unappliable result.
}

rule WorkerPublishesSuccess {
    when: WorkerProposalReady(task, proposed)

    requires: task.check = null
        or (check_preserved_sources(task, proposed)
            and check_exit_code(task, proposed) = 0
            and not check_timed_out(task, proposed))
    ensures: ResultArtifactPublished(task)
    @guidance
        -- The check must preserve ordinary source files including their
        -- permissions; edits restricted to excluded cache directories are
        -- invisible to the census and tolerated.
}

rule WorkerPublishesValidationFailure {
    when: WorkerProposalReady(task, proposed)

    requires: task.check != null
    requires: not check_preserved_sources(task, proposed)
        or check_exit_code(task, proposed) != 0
        or check_timed_out(task, proposed)
    ensures: ResultArtifactPublished(task)
    ensures: WorkerRefusesFurtherWork(task)
    @guidance
        -- A check that edits, creates, or deletes source files fails the
        -- task even when it exits successfully. A timed-out check publishes
        -- the captured output and a timeout diagnostic. The worker exits
        -- unsuccessfully after publishing a non-completed result, so the
        -- result remains retrievable and can never be applied.
}

rule RenewWriterBudget {
    when: WorkerSessionStarted(task)

    requires: task.budget != null
        -- Renewal is enabled only for a budgeted request: the worker
        -- launches with no fixed timeout and Execution's typed policy owns
        -- the writer's process lifecycle, renewing with inline -p or stdin
        -- delivery under the same workspace-write-no-shell policy. A fixed
        -- --timeout request never grants an extension and never grows
        -- toward the cap.
    ensures: BudgetDecision(task)
        -- At each deadline Execution grants an extension only when fresh
        -- qualifying evidence falls inside the progress window: successful
        -- confined writes/edits that changed files, or other restricted tools
        -- with novel inputs that completed successfully. The final extension
        -- is clipped to the finite cap. Repeated identical reads, failures,
        -- and unqualified activity do not renew. The granted
        -- and refused decisions with their evidence age, the termination
        -- reason, progress counts, and the distinct changed-file count are
        -- recorded inside the validated worker result of the published task
        -- result -- the only telemetry schema, never a separate artifact and
        -- never locally reinvented. The statistics describe observed
        -- activity, not usefulness or billed cost. Exhaustion is terminal
        -- for the attempt: no automatic continuation and no automatic retry.
        -- `task continue` requires an unsuccessful terminal attempt with validated
        -- partial edits, not a completed task. Completed work can be verified and
        -- applied before submitting a fresh task. If the edits are unaccepted,
        -- the caller can instead seed an isolated source copy with the validated
        -- diff and submit that copy. `task apply` is bound to the retained original
        -- project; it cannot target an arbitrary copy.
}

-- Durable task lane: application

rule ApplyTaskResult {
    when: ApplyTaskResult(caller, task)

    requires: task.result != null and task.result.status = completed
    requires: task.status != applied
    requires: project_apply_lock_held(task.project)
        -- applications to the same canonical project path serialize; a
        -- competing application is refused until the holder finishes.
    requires:
        for change in task.result.changes:
            destination_matches_before(task.project, change)
        -- every destination: existing bytes and mode equal the change's
        -- before-state, new files do not exist, paths are safe (inside the
        -- project, no symlinked components, no protected agent or VCS
        -- metadata), and content is text within the per-file bound.
    requires: task.symlinks = null or snapshot_link_inventory(task.project) = task.symlinks
        -- When present, the retained carried-link inventory is verified before any write:
        -- a link retargeted, replaced, added, deleted, or made unsafe since
        -- submission is local drift, and the application refuses before the
        -- first byte changes. A change record addressing a link or a
        -- descendant reached through a linked directory is refused at
        -- retrieval, and the safe-path preflight refuses it again here.

    ensures: task.backup = ApplicationBackup.of(task.result.changes)
    ensures:
        for change in task.result.changes:
            apply_change(task.project, change)
    ensures: task.applied_at = now
    ensures: task.status = applied
    ensures: TaskJobAcknowledgmentRequested(task)
    @guidance
        -- The backup journal is written before the first write; a failure
        -- mid-application rolls back in reverse (created files deleted,
        -- prior bytes and modes restored). Application never commits or
        -- deploys. Its applied marker is durable before acknowledgment.
        -- An acknowledgment failure leaves the applied changes intact.
}

rule RetryAppliedTaskAcknowledgment {
    when: ApplyTaskResult(caller, task)

    requires: task.status = applied
    requires: task.processed_at = null
    ensures: TaskJobAcknowledgmentRequested(task)
    @guidance
        -- This retry does not retrieve the result or touch project files.
}

rule AcknowledgeTaskJob {
    when: TaskJobAcknowledgmentRequested(task)

    requires: task.job != null
    requires: task.processed_at = null
    requires: task.job?.status in {completed, failed, dead, canceled, cancelled, killed}
    requires: weft_accepts_processed(task.job)
    ensures: task.processed_at = now
    @guidance
        -- Repeated acknowledgments are idempotent. Only the current job is
        -- marked processed. Failed observation or acknowledgment remains
        -- visible and retryable; passive observation never acknowledges.
}

-- Relay lane

rule StartRelay {
    when: StartRelay(caller, project, prompt, timeout, detached, host?)

    requires: not detached
        -- the relay lane is attached by design; there is no job identity,
        -- no resume, and no detached mode.
    requires: length(prompt) > 0
    requires: timeout > 0.seconds
    requires: remote_preflight_succeeds(host)
    ensures:
        let session = RelaySession.created(
            project: project,
            prompt_digest: digest_of(prompt),
            context_files: local_context_files(project, config.relay_context_file_bytes),
            selector: config.pinned_relay_selector,
            timeout: timeout,
            started_at: now,
            registered_tools: {`review_read`, `review_glob`, `review_grep`},
            remote_events: [],
            read_calls: [],
            status: running,
            durability: "none-attached-live-local-tools",
            snapshot_equivalent: false
        )
    ensures: RemoteBlankRoomConfigured(session)
    @guidance
        -- The relay runtime is materialized outside the installed package
        -- under the state root, keyed by its relay source digest.
        -- The remote runtime is stripped twice: harness flags in the remote
        -- argv and a disable overlay written to a fresh scratch directory.
        -- The conductor attests the same eight flags the bridge sets,
        -- title suppression included.
        -- The remote shell removes that exact scratch directory on exit.
        -- The remote side discovers no project context of its own; it
        -- receives only the explicitly shipped project instructions and the
        -- prompt, both digested. The bridge reads one newline-terminated
        -- request; stdin stays open as its parent lifeline. The local process
        -- group owns the remote tree; it dies with the local command.
}

rule ServeConfinedToolCall {
    when: ReviewToolCall(caller, session, tool, args)

    requires: tool in {`review_read`, `review_glob`, `review_grep`}
    requires: session.status = running
    requires: encoded_size(args) <= config.relay_max_tool_args_bytes
    requires: resolves_inside_root(args, session.project)
        -- canonicalized real paths inside the project root; URL and device
        -- schemes, parent traversal, and symlink escapes are refused, and a
        -- missing path reports confinement rather than filesystem detail.
    requires: serves_regular_text(args, config.relay_max_read_bytes)
    ensures: session.read_calls = session.read_calls
        + ToolCall{
            tool: tool,
            is_error: false,
            -- Exactly one ToolCall per relay call, including a no-match call:
            -- an empty glob or a grep with no hits records an empty
            -- served_paths list and is a successful result. Each served path
            -- carries the real path, the digest of the exact bytes served,
            -- the byte count, and whether truncation cut the output.
            served_paths: ServedEvidence.of(args),
        }
    ensures: ToolResultReturned(session, within_result_bound(config.relay_max_result_bytes))
    @guidance
        -- Every file whose bytes were served carries provenance: real path,
        -- content digest of the exact bytes, byte count, truncation. A
        -- matching file contributing matches that were cut by the output
        -- bound is still recorded. A call that matches nothing records an
        -- empty served_paths list and is a successful result, not an error.
}

rule CompleteRelaySession {
    when: RelayResultFrameReceived(session, frame)

    requires: frame.events = session.remote_events
        -- lifecycle evidence cannot be omitted or substituted
    requires: frame.registered_tools = {`review_read`, `review_glob`, `review_grep`}
    requires: tool_lifecycles_complete(session)
        -- every started tool call has exactly one matching end; unsanctioned
        -- tools, double starts, and unresolved calls refuse the result
    requires: served_paths_inside_root(session)
    requires: frame.model = session.selector
    ensures: session.final_response = frame.response
    ensures: session.status = completed
    ensures: RelayRecordWritten(session)
}

rule FailRelaySession {
    when: RelayFailureObserved(session, reason)

    requires: session.status = running
    ensures: session.failure = reason
    ensures: session.status = failed
    ensures: remote_process_tree_terminated(session)
    @guidance
        -- A failed session may have lost the remote state naming its model;
        -- its record then carries no model, since it claims no response. A
        -- model it does report must be the pinned selector.
    @guidance
        -- A bridge that fails before its ready frame (preflight, runtime start,
        -- or tool registration) reports an error and writes no relay record;
        -- only a stream that reached ready can settle into a record.
    @guidance
        -- Failure is fail-closed at every stage: a refused tool registration,
        -- an incomplete lifecycle, a served path outside the root, or a
        -- bridge that exits without a result is refused, and a remote
        -- failure never falls back to enabling remote tools.
}

rule TimeoutRelaySession {
    when: session: RelaySession.started_at + session.timeout + config.relay_grace <= now

    requires: session.status = running
    ensures: session.status = failed
    ensures: session.failure = "relay exceeded its timeout"
    ensures: remote_process_tree_terminated(session)
}

rule CancelRelaySession {
    when: CancelRelay(caller, session)

    requires: session.status = running
    ensures: session.status = cancelled
    ensures: session.failure = "cancelled locally"
    ensures: remote_process_tree_terminated(session)
    @guidance
        -- No relay record is written. The conductor terminates the bridge's
        -- process group on interrupt rather than waiting for a cancellation
        -- result, and the command exits with an error.
}

rule LoseRelayParent {
    when: RelayParentExited(session)

    requires: session.status = running
    ensures: session.status = cancelled
    ensures: session.failure = "relay parent exited"
    ensures: remote_process_tree_terminated(session)
    @guidance
        -- The record writer is gone, so no relay record is written.
}

-- Historical lane

rule ValidateHistoricalJob {
    when: RetrieveHistoricalJob(caller, record, mark_processed)

    let envelope = EnvelopeOf(record.job)

    requires: owned_by_this_system(record.job)
    requires: record.job?.status in {completed, failed, dead, canceled, cancelled, killed}
    requires: declared_artifacts(record.job) = {"task result artifact", "report artifact"}
    requires: record.job?.source_pin != null
        -- Implementation delta: the CLI retrieval path does not enforce the
        -- source pin; it validates the task id against the artifact name,
        -- the pinned provider, mode and selector, and a report digest for
        -- completed results.
    requires: envelope_identity_matches(envelope, record.expected_task_id)
        -- provider and mode pinned to the retired report lane, selector
        -- pinned to config.historical_selector, task id and prompt digest
        -- matching the dispatch, report digest matching the report text
    requires: not (envelope.nested_evidence_present
        and not envelope.nested_source_digest_retained)
    requires: envelope.status != completed
        or (length(envelope.report) > 0 and envelope.snapshot_preserved)
        -- Implementation delta: a completed envelope always requires
        -- completed nested evidence, so on the CLI path a completed result
        -- without a retained nested baseline refuses under
        -- RefuseUnverifiableHistoricalEvidence; and the processed
        -- transition happens only when Weft accepts the mark-processed
        -- request.
    ensures: HistoricalResult.created(
        record: record,
        envelope_status: envelope.status,
        provider: envelope.provider,
        mode: envelope.mode,
        selector: envelope.selector,
        prompt_digest: envelope.prompt_digest,
        report: envelope.report,
        report_digest: digest_of(envelope.report),
        snapshot_preserved: envelope.snapshot_preserved,
        nested_evidence_present: envelope.nested_evidence_present,
        nested_source_digest_retained: envelope.nested_source_digest_retained
    )
    ensures: report_artifact_byte_equals(envelope.report)
    ensures:
        if mark_processed:
            record.status = processed
            record.processed_at = now
        else:
            record.status = validated
}

rule RefuseUnverifiableHistoricalEvidence {
    when: RetrieveHistoricalJob(caller, record, mark_processed)

    let envelope = EnvelopeOf(record.job)

    requires: envelope.nested_evidence_present
    requires: not envelope.nested_source_digest_retained
    ensures: record.status = refused
    ensures: record.refusal_reason = "historical nested execution evidence is unverifiable: the accepted dispatch did not retain a nested worker source baseline"
    ensures: HistoricalRefusalReported(record)
    @guidance
        -- Nested worker evidence whose source baseline was never retained is
        -- unverifiable in principle: no later installation and no digest the
        -- result claims about itself can supply it. This refusal is
        -- permanent and the job is never marked processed.
}

rule RefuseRetiredNativeSubmission {
    when: RequestNativeRun(caller, brief)

    ensures: RetirementRefusalReported("native Codex execution is retired; use the grounded OMP Anthropic route or an OpenAI packet-only route")
    @guidance
        -- The refusal happens before any Weft job is created; there is no
        -- provider escape hatch and no fallback to another lane.
}

-- Task-lane doctor v2 and Execution-owned observations

rule ReportTaskWriterAdmission {
    when: RunDoctor(caller, host, account, provider?, selector?)

    requires: selector != null or provider != "codex"
    let requested = doctor_selection(provider, selector)
        -- Exact selector overrides provider; provider selects all admitted
        -- task writers; no options selects the configured default.
    ensures: DoctorReported(
        schema: "agent-offload.doctor/v2",
        execution_status: fresh_execution_status(host, account, "omp", "offload-task", requested),
        admission: task_admission("offload-task/v1", requested)
    )
    @guidance
        -- Execution owns public schema, exact selector coverage, identity,
        -- fact validation and observation provenance. Offload policy requires
        -- current available capability, authentication, and transport. A
        -- current explicit quota refusal blocks; unknown quota is not a
        -- promise of capacity. Failed probes set execution_status null and
        -- report the policy reason; no universal available flag is emitted.
}

rule RefuseNativeCodexAdmission {
    when: RunDoctor(caller, host, account, provider?, selector?)

    requires: selector = null and provider = "codex"
    ensures: DoctorReported(schema: "agent-offload.doctor/v2", execution_status: null,
        admission: denied("offload-task/v1", "native Codex execution is retired"))
    ensures: RetirementRefusalReported("native Codex execution is retired; use the grounded OMP Anthropic route or an OpenAI packet-only route")
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant UniqueTaskIdentity {
    for a in Tasks:
        for b in Tasks:
            a != b implies a.id != b.id
}

invariant NewJobsRequireExecutionStatusAdmission {
    -- New Weft submissions obtain fresh Execution-owned exact-selector facts
    -- through the provisioned worker build, and the pinned task executor probes
    -- again immediately before generation. Offload requires current capability,
    -- authentication, and transport; a current explicit quota refusal blocks,
    -- while unknown quota is not a capacity promise. A refusal before submission
    -- leaves no new job and names the retained identity and resume command.
    -- A refusal on the executor publishes a terminal failed result for its
    -- accepted job without running the model. Resume reports that result;
    -- retrying after fixing the cause requires a new task identity.
    -- Exempt: an accepted job recovered from Weft by the attempt's
    -- idempotency key. A send that may have reached Weft (unresolved, or
    -- interrupted after `weft run` began) is reconciled by that key before
    -- any provisioning or readiness check, and a recorded job is bound
    -- however readiness has since changed; a failed or malformed lookup is
    -- not evidence of absence and leaves the submission unresolved.
    -- A not-found lookup permits an idempotent resend, not release of custody:
    -- an earlier in-flight request may still be accepted. Cancellation of an
    -- ambiguous attempt instead requires the public producer fence; only its
    -- validated final-no-job answer permits closure, while a receipt is bound
    -- before existing job cancellation and acknowledgment.
    for task in Tasks:
        task.job != null and not recovered_by_idempotency_key(task)
            implies execution_status_admitted_before_send(task)
        generation_started(task)
            implies fresh_execution_status_admitted_before_generation(task)
}

invariant NoUnvalidatedOutcome {
    for task in Tasks:
        task.status in {completed, failed, validation_failed}
            implies task.result != null
}

invariant SuccessRequiresWorkerAndCheck {
    for task in Tasks:
        task.status = completed
            implies task.result?.worker_completed
                and (task.check = null or task.result?.validation?.exit_code = 0)
}

invariant AppliedImpliesCompletedAndBackedUp {
    for task in Tasks:
        task.status = applied
            implies task.result?.status = completed
                and task.backup != null
}

invariant RelayProvenanceComplete {
    for session in RelaySessions:
        for call in session.read_calls:
            for served in call.served_paths:
                served.content_digest != null
                    -- Provenance is required for every path whose bytes were
                    -- actually served. A call that matched nothing records an
                    -- empty served_paths list and is a successful result, not
                    -- an error: an empty glob or a grep with no hits returns
                    -- its explanatory content with nothing served.
}

invariant RenewalOnlyUnderPersistedPolicy {
    -- Renewal is enabled only by the request's persisted approved policy: a
    -- fixed --timeout is a hard limit that never silently grows toward the
    -- cap, and budget evidence exists only for a budgeted task.
    for task in Tasks:
        task.budget = null implies task.result?.budget_evidence = null
}

invariant HistoricalRefusalsNeverProcessed {
    for record in HistoricalJobs:
        record.status = refused implies record.processed_at = null
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface TaskControl {
    facing caller: Principal
    context task: Task

    exposes:
        task.status
        task.job?.status
        task.prior_job_ids
        task.error
        task.result?.status
        task.result?.validation

    provides:
        SubmitTask(caller, project, brief, selector, check, timeout, budget?, account?, requested_id?)
        ObserveTask(caller, task)
        ResumeTask(caller, task)
        ContinueTask(caller, parent, timeout, budget?, supplement?, requested_id?)
        CancelTask(caller, task)
        RetrieveTaskResult(caller, task)
        ApplyTaskResult(caller, task)

    contracts:
        fulfils EvidenceContract

    @guarantee EvidenceBasedStatus
        -- Status is asserted only from validated task results. Job
        -- completion, exit codes, and absence of failure never establish
        -- success; unreadable or ambiguous evidence reports unknown or
        -- failed_without_result with a diagnostic.
    @guarantee NoLocalFallback
        -- A submission failure never falls back to local execution; the
        -- identity and its request are retained for explicit resume.
}

surface WorkerExecution {
    facing task_worker: Principal
    context task: Task

    provides:
        WorkerExecutionBegan(task, payload)

    contracts:
        demands EvidenceContract

    @guarantee SnapshotOnly
        -- The worker sees exactly the snapshot the baseline describes, under
        -- a workspace-write policy that admits no shell; anything else it
        -- might reach is outside this specification's grant.
}

surface RelayLaunch {
    facing caller: Principal

    provides:
        StartRelay(caller, project, prompt, timeout, detached, host?)
        CancelRelay(caller, session)

    contracts:
        fulfils EvidenceContract

    @guarantee AttachedOnly
        -- The command stays in the foreground; the remote process tree dies
        -- with it. Detachment is refused; there is no job id and no resume.
    @guarantee BlankRoom
        -- The remote runtime discovers nothing on its own: built-in tools,
        -- extensions, skills, rules, sessions, and terminals are disabled
        -- twice, and only the explicitly shipped project instructions and
        -- prompt reach it, with digests recorded.
}

surface RelayToolAccess {
    facing remote_agent: Principal
    context session: RelaySession

    exposes:
        session.project.root

    provides:
        ReviewToolCall(caller, session, tool, args)

    contracts:
        demands EvidenceContract

    @guarantee Confinement
        -- Exactly the three sanctioned tools are registered; paths resolve
        -- inside the project root; reads, matches, traversals, argument and
        -- result sizes, and wall time are bounded; text-only inputs; any
        -- violation refuses rather than degrades, and a remote failure never
        -- enables remote tools.
    @guarantee LiveTreeProvenance
        -- The tree is live, so two reads may observe different revisions;
        -- the record therefore claims snapshot equivalence never, and serves
        -- per-call provenance for every byte actually delivered.
}

surface RelayBridge {
    facing relay_bridge: Principal
    context session: RelaySession

    provides:
        RelayResultFrameReceived(session, frame)
        RelayFailureObserved(session, reason)

    contracts:
        fulfils EvidenceContract

    @guarantee StreamFidelity
        -- The result frame must equal the streamed event record exactly; a
        -- bridge that exits without a result frame is refused as a partial
        -- stream and is never treated as an outcome.
}

surface HistoricalArchive {
    facing caller: Principal
    context record: HistoricalJob

    exposes:
        record.job?.status
        record.status
        record.refusal_reason
        record.result?.report

    provides:
        RetrieveHistoricalJob(caller, record, mark_processed)
        InspectWeftJob(caller, record.job)
        RequestNativeRun(caller, brief)

    contracts:
        fulfils EvidenceContract

    @guarantee UnverifiableEvidenceIsTerminal
        -- Nested worker evidence without a retained source baseline is
        -- refused at every retrieval, by every later installation, forever;
        -- the artifacts stay available in Weft and the job is never marked
        -- processed.
}

surface WriterReadiness {
    facing caller: Principal

    provides:
        RunDoctor(caller, host, account, provider?, selector?)

    @guarantee ObservationOnly
        -- Readiness reports the observed pinned catalog and execution-eligible
        -- credentials of exact admitted task writers. It never generates a
        -- model response, makes no live-quota claim, and never queues a job.
        -- Native codex is only reported as retired when explicitly requested.
}

